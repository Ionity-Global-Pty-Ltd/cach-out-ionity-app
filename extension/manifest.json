{
  "manifest_version": 3,
  "name": "CACH OUT Ionity",
  "version": "1.0.0",
  "description": "One-click privacy reset for IONITY.co.za — clears cache, cookies, local storage, IndexedDB, service workers and more across all sites.",
  "permissions": ["browsingData", "tabs"],
  "action": {
    "default_title": "CACH OUT Ionity",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
